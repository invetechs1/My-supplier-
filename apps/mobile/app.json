{
  "expo": {
    "name": "MySupplier",
    "slug": "mysupplier",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mysupplier",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0B6E4F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.mysupplier.app"
    },
    "android": {
      "package": "sa.mysupplier.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B6E4F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
