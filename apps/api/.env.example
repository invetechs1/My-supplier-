DATABASE_URL="postgresql://mysupplier:mysupplier@localhost:5432/mysupplier?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:19006"

# --- Production settings (see deploy/GO-LIVE.md) ---
NODE_ENV=development
API_URL="http://localhost:4000/api/v1"
WEB_URL="http://localhost:3000"
APP_SCHEME="mysupplier"
# Email (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MySupplier <no-reply@mysupplier.sa>"
# Payments – Moyasar (card payments are enabled only when both keys are set). See docs/INTEGRATIONS.md "Payments".
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
# Shared secret of the dashboard webhook → https://<api>/api/v1/payments/webhook/moyasar
MOYASAR_WEBHOOK_SECRET=""
# Form methods (mada is part of creditcard). Apple Pay also needs the domain verification file served by the web app.
MOYASAR_METHODS="creditcard,applepay,stcpay"
# Legal entity for invoices (ZATCA QR) and bank transfer instructions
PLATFORM_LEGAL_NAME="MySupplier Trading Co."
PLATFORM_VAT_NUMBER="300000000000003"
PLATFORM_ADDRESS="Riyadh, Kingdom of Saudi Arabia"
VAT_RATE=0.15
BANK_NAME="Al Rajhi Bank"
BANK_IBAN="SA00 0000 0000 0000 0000 0000"
BANK_BENEFICIARY="MySupplier Trading Co."
# AI price collection (Claude). Leave empty to fall back to heuristics for text/CSV/Excel.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Weekly supplier outreach emails for stale prices
OUTREACH_AUTO=false
OUTREACH_STALE_DAYS=14
# Uploads (logos, verification documents). Local disk by default; put an S3/CDN URL in UPLOAD_BASE_URL when using object storage.
UPLOAD_DIR="./uploads"
UPLOAD_BASE_URL=""
# Monitoring
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
# Allow feeds pointing at private networks (development only)
ALLOW_PRIVATE_FEED_URLS=true
# SMS (Unifonic) for OTP login. Empty = codes are logged (development uses 123456).
UNIFONIC_APP_SID=""
UNIFONIC_SENDER_ID=
# WhatsApp alerts (Meta WhatsApp Cloud API). Business-initiated alerts need an approved template with one body
# parameter {{1}}; without a template the API only delivers inside a 24-hour customer-service window.
# Unifonic SMS (above) is the automatic fallback when WhatsApp is not configured or the user opted out.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_ALERT=mysupplier_alert
WHATSAPP_TEMPLATE_LANG=ar
WHATSAPP_API_VERSION=v21.0
# Max phone alerts per user per 24 h (cost control)
ALERT_DAILY_CAP=15
"MySupplier"
# Carriers (docs/INTEGRATIONS.md "Carriers") – quoting works from rate cards without keys; a carrier whose required
# keys are set books, tracks, labels and cancels through its API. CARRIER_SANDBOX=1 makes every configured carrier
# return deterministic fake "SBX-" bookings without network calls (staging). <CARRIER>_API_URL switches sandbox/live hosts.
# Webhooks: POST ${API_URL}/shipping/webhooks/<carrier> verified with <CARRIER>_WEBHOOK_SECRET (HMAC-SHA256 of the raw
# body in x-signature, or the secret itself in x-webhook-token). CARRIER_WEBHOOK_SECRET is the legacy shared fallback.
CARRIER_SANDBOX=0
CARRIER_POLL_LIMIT=50
CARRIER_WEBHOOK_SECRET=""
# SMSA Express B2C (apikey header). Production https://ecomapis.smsaexpress.com; SMSA gives a staging host for test keys.
SMSA_API_KEY=""
SMSA_API_URL=""
SMSA_CUSTOMER_CODE=""
SMSA_WEBHOOK_SECRET=""
# Aramex Shipping API v2 (ClientInfo). ARAMEX_API_KEY is the web-service password. Sandbox: https://ws.sbx.aramex.net/ShippingAPI.V2
ARAMEX_USERNAME=""
ARAMEX_API_KEY=""
ARAMEX_ACCOUNT_NUMBER=""
ARAMEX_ACCOUNT_PIN=""
ARAMEX_ACCOUNT_ENTITY="RUH"
ARAMEX_API_URL=""
ARAMEX_WEBHOOK_SECRET=""
# Saudi Post SPL (x-api-key + x-customer-id)
SPL_API_KEY=""
SPL_CUSTOMER_ID=""
SPL_API_URL=""
SPL_WEBHOOK_SECRET=""
# Heavy trucking marketplaces (bearer token; base URL from onboarding)
TRUKKER_API_KEY=""
TRUKKER_API_URL=""
TRUKKER_WEBHOOK_SECRET=""
TRELLA_API_KEY=""
TRELLA_API_URL=""
TRELLA_WEBHOOK_SECRET=""
# ZATCA phase 2 (after Fatoora onboarding). Leave empty until certified.
ZATCA_API_BASE=""
ZATCA_BINARY_TOKEN=""
ZATCA_SECRET=""

# Reverse-proxy hops in front of the API (Caddy/nginx = 1, none in local dev). Controls which X-Forwarded-For entry rate limiting trusts.
TRUST_PROXY=1
