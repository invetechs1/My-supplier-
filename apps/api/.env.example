DATABASE_URL="postgresql://mysupplier:mysupplier@localhost:5432/mysupplier?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:19006"

# --- Production settings (see deploy/GO-LIVE.md) ---
NODE_ENV=development
API_URL="http://localhost:4000/api/v1"
WEB_URL="http://localhost:3000"
APP_SCHEME="mysupplier"
# Email (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MySupplier <no-reply@mysupplier.sa>"
# Payments – Moyasar (card payments are enabled only when both keys are set)
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""
# Legal entity for invoices (ZATCA QR) and bank transfer instructions
PLATFORM_LEGAL_NAME="MySupplier Trading Co."
PLATFORM_VAT_NUMBER="300000000000003"
PLATFORM_ADDRESS="Riyadh, Kingdom of Saudi Arabia"
VAT_RATE=0.15
BANK_NAME="Al Rajhi Bank"
BANK_IBAN="SA00 0000 0000 0000 0000 0000"
BANK_BENEFICIARY="MySupplier Trading Co."
# AI price collection (Claude). Leave empty to fall back to heuristics for text/CSV/Excel.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Weekly supplier outreach emails for stale prices
OUTREACH_AUTO=false
OUTREACH_STALE_DAYS=14
# Uploads (logos, verification documents). Local disk by default; put an S3/CDN URL in UPLOAD_BASE_URL when using object storage.
UPLOAD_DIR="./uploads"
UPLOAD_BASE_URL=""
# Monitoring
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
# Allow feeds pointing at private networks (development only)
ALLOW_PRIVATE_FEED_URLS=true
# SMS (Unifonic) for OTP login. Empty = codes are logged (development uses 123456).
UNIFONIC_APP_SID=""
UNIFONIC_SENDER_ID="MySupplier"
# Carriers – quoting works from rate cards without keys; set a key to enable API booking for that carrier
TRUKKER_API_KEY=""
TRELLA_API_KEY=""
SMSA_API_KEY=""
ARAMEX_API_KEY=""
SPL_API_KEY=""
CARRIER_WEBHOOK_SECRET=""
# ZATCA phase 2 (after Fatoora onboarding). Leave empty until certified.
ZATCA_API_BASE=""
ZATCA_BINARY_TOKEN=""
ZATCA_SECRET=""
