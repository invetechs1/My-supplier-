DATABASE_URL="postgresql://mysupplier:mysupplier@localhost:5432/mysupplier?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:19006"

# --- Production settings (see deploy/GO-LIVE.md) ---
NODE_ENV=development
API_URL="http://localhost:4000/api/v1"
WEB_URL="http://localhost:3000"
APP_SCHEME="mysupplier"
# Email (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MySupplier <no-reply@mysupplier.sa>"
# Payments – Moyasar (card payments are enabled only when both keys are set)
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""
# Legal entity for invoices (ZATCA QR) and bank transfer instructions
PLATFORM_LEGAL_NAME="MySupplier Trading Co."
PLATFORM_VAT_NUMBER="300000000000003"
PLATFORM_ADDRESS="Riyadh, Kingdom of Saudi Arabia"
VAT_RATE=0.15
BANK_NAME="Al Rajhi Bank"
BANK_IBAN="SA00 0000 0000 0000 0000 0000"
BANK_BENEFICIARY="MySupplier Trading Co."
