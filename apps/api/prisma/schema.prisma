generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum CompanyType {
  SUPPLIER
  CONTRACTOR
  CONSULTANT
  OTHER
}

enum PriceSource {
  SUPPLIER
  MARKET
  IMPORTED
  QUOTATION
}

enum RfqStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderType {
  RFQ
  DIRECT
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MaterialSource {
  CURATED
  SUPPLIER
  FEED
}

enum NotificationType {
  NEW_RFQ
  NEW_BID
  BID_ACCEPTED
  BID_REJECTED
  ORDER_UPDATE
  SYSTEM
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role           @default(BUYER)
  locale        String         @default("en")
  active        Boolean        @default(true)
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  companyRole   CompanyRole?
  lastLoginAt   DateTime?
  phoneVerified Boolean        @default(false)
  rfqs          Rfq[]
  orders        Order[]
  notifications Notification[]
  cart          Cart?
  devices       Device[]
  resetTokens   PasswordResetToken[]
  imports       PriceImport[]
  sentInvites   CompanyInvite[]
  stockMoves    StockMovement[]
  orderEvents   OrderEvent[]
  messages      OrderMessage[]
  reviews       Review[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Company {
  id          String         @id @default(cuid())
  name        String
  nameAr      String?
  type        CompanyType    @default(SUPPLIER)
  crNumber    String?
  vatNumber   String?
  city        String
  region      String?
  phone       String?
  website     String?
  verified    Boolean        @default(false)
  rating      Float          @default(0)
  ratingCount Int            @default(0)
  slug        String?        @unique
  logoUrl     String?
  description String?
  descriptionAr String?
  citiesServed String[]      @default([])
  minOrderValue Decimal?     @db.Decimal(14, 2)
  deliveryFee   Decimal?     @db.Decimal(14, 2)
  deliveryDays  Int?
  workingHours  String?
  email         String?
  bankName      String?
  iban          String?
  beneficiary   String?
  lowStockThreshold Int      @default(10)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  commissionPct Decimal?     @db.Decimal(5, 2)
  invites     CompanyInvite[]
  documents   CompanyDocument[]
  branches    Branch[]
  reviews     Review[]
  payouts     Payout[]
  users       User[]
  listings    PriceListing[]
  bids        Bid[]
  orders      Order[]
  imports     PriceImport[]
  updateRequests PriceUpdateRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([city])
  @@index([type, verified])
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  nameAr    String
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  materials Material[]
  createdAt DateTime   @default(now())
}

model Material {
  id          String         @id @default(cuid())
  sku         String         @unique
  name        String
  nameAr      String
  unit        String
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  brand       String?
  specs       Json?
  imageUrl    String?
  description String?
  active      Boolean        @default(true)
  tags        String[]       @default([])
  featured    Boolean        @default(false)
  source      MaterialSource @default(CURATED)
  popularity  Int            @default(0)
  weightKg    Float?
  volumeM3    Float?
  hazardous   Boolean        @default(false)
  listings    PriceListing[]
  rfqItems    RfqItem[]
  history     PriceHistory[]
  orderItems  OrderItem[]
  importRows  PriceImportRow[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([name])
  @@index([featured])
}

model PriceListing {
  id           String      @id @default(cuid())
  materialId   String
  material     Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  price        Decimal     @db.Decimal(14, 2)
  currency     String      @default("SAR")
  minQty       Float       @default(1)
  leadTimeDays Int         @default(1)
  city         String
  source       PriceSource @default(SUPPLIER)
  sourceName   String?
  validUntil   DateTime?
  stock        Int?
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  movements    StockMovement[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([materialId, companyId, city, sourceName])
  @@index([materialId, city])
  @@index([companyId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  avg        Decimal  @db.Decimal(14, 2)
  min        Decimal  @db.Decimal(14, 2)
  max        Decimal  @db.Decimal(14, 2)

  @@unique([materialId, date])
}

model Rfq {
  id              String    @id @default(cuid())
  reference       String    @unique
  buyerId         String
  buyer           User      @relation(fields: [buyerId], references: [id])
  title           String
  status          RfqStatus @default(OPEN)
  deliveryCity    String
  deliveryAddress String?
  deliveryDate    DateTime?
  closesAt        DateTime
  notes           String?
  awardedBidId    String?
  items           RfqItem[]
  bids            Bid[]
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, closesAt])
  @@index([buyerId])
  @@index([deliveryCity])
}

model RfqItem {
  id          String    @id @default(cuid())
  rfqId       String
  rfq         Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  description String
  quantity    Float
  unit        String
  notes       String?
  bidItems    BidItem[]
}

model Bid {
  id           String    @id @default(cuid())
  rfqId        String
  rfq          Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  totalPrice   Decimal   @db.Decimal(14, 2)
  currency     String    @default("SAR")
  validUntil   DateTime
  deliveryDays Int       @default(7)
  notes        String?
  status       BidStatus @default(SUBMITTED)
  items        BidItem[]
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([rfqId, companyId])
  @@index([companyId, status])
}

model BidItem {
  id           String  @id @default(cuid())
  bidId        String
  bid          Bid     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  rfqItemId    String
  rfqItem      RfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)
  unitPrice    Decimal @db.Decimal(14, 2)
  quantity     Float
  leadTimeDays Int     @default(7)
  notes        String?
}

model Order {
  id              String         @id @default(cuid())
  reference       String         @unique
  type            OrderType      @default(RFQ)
  rfqId           String?
  rfq             Rfq?           @relation(fields: [rfqId], references: [id])
  bidId           String?
  bid             Bid?           @relation(fields: [bidId], references: [id])
  buyerId         String
  buyer           User           @relation(fields: [buyerId], references: [id])
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  items           OrderItem[]
  subtotal        Decimal        @default(0) @db.Decimal(14, 2)
  vat             Decimal        @default(0) @db.Decimal(14, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(14, 2)
  total           Decimal        @db.Decimal(14, 2)
  currency        String         @default("SAR")
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus  @default(UNPAID)
  deliveryCity    String?
  deliveryAddress String?
  contactPhone    String?
  notes           String?
  payments        Payment[]
  events          OrderEvent[]
  messages        OrderMessage[]
  review          Review?
  stockMoves      StockMovement[]
  payoutId        String?
  payout          Payout?        @relation(fields: [payoutId], references: [id])
  shipments       Shipment[]
  einvoice        EInvoiceRecord?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([buyerId])
  @@index([companyId])
  @@index([type, status])
  @@index([payoutId])
}

model OrderItem {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material?     @relation(fields: [materialId], references: [id])
  listingId  String?
  listing    PriceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name       String
  unit       String
  unitPrice  Decimal       @db.Decimal(14, 2)
  quantity   Float
  lineTotal  Decimal       @db.Decimal(14, 2)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String       @id @default(cuid())
  cartId    String
  cart      Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId String
  listing   PriceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Float
  createdAt DateTime     @default(now())

  @@unique([cartId, listingId])
}

model Feed {
  id            String    @id @default(cuid())
  name          String    @unique
  url           String
  format        String    @default("json")
  companyId     String?
  city          String?
  autoPublish   Boolean   @default(false)
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  lastStatus    String?
  lastItemCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

enum PaymentProvider {
  MOYASAR
  MANUAL
}

enum PaymentRecordStatus {
  INITIATED
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider     @default(MOYASAR)
  providerPaymentId String?             @unique
  amount            Decimal             @db.Decimal(14, 2)
  currency          String              @default("SAR")
  status            PaymentRecordStatus @default(INITIATED)
  raw               Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum ImportKind {
  SUPPLIER_PRICE_LIST
  BUYER_QUOTATION
  WEB_PAGE
  TEXT
}

enum ImportStatus {
  PROCESSING
  REVIEW
  PUBLISHED
  FAILED
  REJECTED
}

enum ImportRowStatus {
  SUGGESTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum OutreachChannel {
  EMAIL
  WHATSAPP
  LINK
}

model PriceImport {
  id             String           @id @default(cuid())
  kind           ImportKind
  status         ImportStatus     @default(PROCESSING)
  sourceName     String
  supplierName   String?
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id])
  uploadedById   String
  uploadedBy     User             @relation(fields: [uploadedById], references: [id])
  fileName       String?
  mimeType       String?
  city           String?
  quotationDate  DateTime?
  aiUsed         Boolean          @default(false)
  model          String?
  extractedCount Int              @default(0)
  publishedCount Int              @default(0)
  error          String?
  rawText        String?
  feedId         String?
  rows           PriceImportRow[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([uploadedById])
  @@index([status, kind])
}

model PriceImportRow {
  id             String          @id @default(cuid())
  importId       String
  import         PriceImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  rawName        String
  rawUnit        String?
  rawPrice       String?
  rawCity        String?
  brand          String?
  notes          String?
  price          Decimal?        @db.Decimal(14, 2)
  unit           String
  city           String?
  materialId     String?
  material       Material?       @relation(fields: [materialId], references: [id])
  confidence     Float           @default(0)
  alternatives   Json?
  status         ImportRowStatus @default(SUGGESTED)
  createMaterial Boolean         @default(false)
  position       Int             @default(0)

  @@index([importId])
}

model PriceUpdateRequest {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenHash   String          @unique
  channel     OutreachChannel @default(LINK)
  createdById String?
  sentAt      DateTime        @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  updatedRows Int             @default(0)

  @@index([companyId])
}

enum CompanyRole {
  OWNER
  MANAGER
  SALES
  WAREHOUSE
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum DocumentType {
  CR
  VAT
  LICENSE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  RESERVE
  RELEASE
}

enum PayoutStatus {
  PENDING
  PAID
}

enum OrderEventType {
  CREATED
  STATUS
  PAYMENT
  NOTE
  MESSAGE
  REVIEW
}

model CompanyInvite {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  role        CompanyRole @default(SALES)
  tokenHash   String      @unique
  invitedById String
  invitedBy   User        @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([companyId])
}

model CompanyDocument {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileName     String
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  notes        String?
  uploadedById String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([companyId])
}

model Branch {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  city      String
  address   String?
  phone     String?
  isDefault Boolean        @default(false)
  listings  PriceListing[]
  shipments Shipment[]
  createdAt DateTime       @default(now())

  @@index([companyId])
}

model StockMovement {
  id           String            @id @default(cuid())
  listingId    String
  listing      PriceListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  companyId    String
  type         StockMovementType
  quantity     Float
  balanceAfter Float?
  reason       String?
  orderId      String?
  order        Order?            @relation(fields: [orderId], references: [id])
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  createdAt    DateTime          @default(now())

  @@index([listingId])
  @@index([companyId, createdAt])
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  status    OrderStatus?
  message   String?
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())

  @@index([orderId])
}

model OrderMessage {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id])
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orderId])
}

model Review {
  id        String    @id @default(cuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User      @relation(fields: [buyerId], references: [id])
  rating    Int
  comment   String?
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId])
}

model Payout {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  amount      Decimal      @db.Decimal(14, 2)
  currency    String       @default("SAR")
  periodStart DateTime
  periodEnd   DateTime
  orderCount  Int          @default(0)
  status      PayoutStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?
  createdById String?
  orders      Order[]
  createdAt   DateTime     @default(now())

  @@index([companyId, status])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum ShipmentStatus {
  PENDING
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum CarrierCode {
  SUPPLIER
  TRUKKER
  TRELLA
  SMSA
  ARAMEX
  SPL
  OTHER
}

enum ShippingZone {
  SAME_CITY
  SAME_REGION
  NATIONAL
}

enum EInvoiceStatus {
  GENERATED
  REPORTED
  CLEARED
  REJECTED
  PENDING_CONFIG
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String   @default("LOGIN")
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        CarrierCode     @default(SUPPLIER)
  carrierName    String
  service        String?
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus  @default(PENDING)
  cost           Decimal?        @db.Decimal(14, 2)
  weightKg       Float?
  volumeM3       Float?
  pickupBranchId String?
  pickupBranch   Branch?         @relation(fields: [pickupBranchId], references: [id], onDelete: SetNull)
  driverName     String?
  driverPhone    String?
  vehicle        String?
  scheduledAt    DateTime?
  deliveredAt    DateTime?
  externalId     String?
  events         ShipmentEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  description String?
  location    String?
  createdAt   DateTime       @default(now())

  @@index([shipmentId])
}

model ShippingRate {
  id          String       @id @default(cuid())
  carrier     CarrierCode
  zone        ShippingZone
  service     String
  baseFee     Decimal      @db.Decimal(14, 2)
  perKg       Decimal      @default(0) @db.Decimal(14, 4)
  includedKg  Float        @default(0)
  perM3       Decimal      @default(0) @db.Decimal(14, 2)
  minFee      Decimal      @default(0) @db.Decimal(14, 2)
  maxWeightKg Float?
  etaDays     Int          @default(2)
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([carrier, zone])
}

model EInvoiceRecord {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber       String         @unique
  uuid                String         @unique
  invoiceHash         String
  previousInvoiceHash String
  counter             Int
  xml                 String
  status              EInvoiceStatus @default(GENERATED)
  zatcaResponse       Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}
