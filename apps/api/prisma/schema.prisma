generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum CompanyType {
  SUPPLIER
  CONTRACTOR
  CONSULTANT
  OTHER
}

enum PriceSource {
  SUPPLIER
  MARKET
  IMPORTED
  QUOTATION
}

enum RfqStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderType {
  RFQ
  DIRECT
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MaterialSource {
  CURATED
  SUPPLIER
  FEED
}

enum NotificationType {
  NEW_RFQ
  NEW_BID
  BID_ACCEPTED
  BID_REJECTED
  ORDER_UPDATE
  SYSTEM
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role           @default(BUYER)
  locale        String         @default("en")
  active        Boolean        @default(true)
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  rfqs          Rfq[]
  orders        Order[]
  notifications Notification[]
  cart          Cart?
  devices       Device[]
  resetTokens   PasswordResetToken[]
  imports       PriceImport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Company {
  id          String         @id @default(cuid())
  name        String
  nameAr      String?
  type        CompanyType    @default(SUPPLIER)
  crNumber    String?
  vatNumber   String?
  city        String
  region      String?
  phone       String?
  website     String?
  verified    Boolean        @default(false)
  rating      Float          @default(0)
  ratingCount Int            @default(0)
  users       User[]
  listings    PriceListing[]
  bids        Bid[]
  orders      Order[]
  imports     PriceImport[]
  updateRequests PriceUpdateRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([city])
  @@index([type, verified])
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  nameAr    String
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  materials Material[]
  createdAt DateTime   @default(now())
}

model Material {
  id          String         @id @default(cuid())
  sku         String         @unique
  name        String
  nameAr      String
  unit        String
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  brand       String?
  specs       Json?
  imageUrl    String?
  description String?
  active      Boolean        @default(true)
  tags        String[]       @default([])
  featured    Boolean        @default(false)
  source      MaterialSource @default(CURATED)
  popularity  Int            @default(0)
  listings    PriceListing[]
  rfqItems    RfqItem[]
  history     PriceHistory[]
  orderItems  OrderItem[]
  importRows  PriceImportRow[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([name])
  @@index([featured])
}

model PriceListing {
  id           String      @id @default(cuid())
  materialId   String
  material     Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  price        Decimal     @db.Decimal(14, 2)
  currency     String      @default("SAR")
  minQty       Float       @default(1)
  leadTimeDays Int         @default(1)
  city         String
  source       PriceSource @default(SUPPLIER)
  sourceName   String?
  validUntil   DateTime?
  stock        Int?
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([materialId, companyId, city, sourceName])
  @@index([materialId, city])
  @@index([companyId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  avg        Decimal  @db.Decimal(14, 2)
  min        Decimal  @db.Decimal(14, 2)
  max        Decimal  @db.Decimal(14, 2)

  @@unique([materialId, date])
}

model Rfq {
  id              String    @id @default(cuid())
  reference       String    @unique
  buyerId         String
  buyer           User      @relation(fields: [buyerId], references: [id])
  title           String
  status          RfqStatus @default(OPEN)
  deliveryCity    String
  deliveryAddress String?
  deliveryDate    DateTime?
  closesAt        DateTime
  notes           String?
  awardedBidId    String?
  items           RfqItem[]
  bids            Bid[]
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, closesAt])
  @@index([buyerId])
  @@index([deliveryCity])
}

model RfqItem {
  id          String    @id @default(cuid())
  rfqId       String
  rfq         Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  description String
  quantity    Float
  unit        String
  notes       String?
  bidItems    BidItem[]
}

model Bid {
  id           String    @id @default(cuid())
  rfqId        String
  rfq          Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  totalPrice   Decimal   @db.Decimal(14, 2)
  currency     String    @default("SAR")
  validUntil   DateTime
  deliveryDays Int       @default(7)
  notes        String?
  status       BidStatus @default(SUBMITTED)
  items        BidItem[]
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([rfqId, companyId])
  @@index([companyId, status])
}

model BidItem {
  id           String  @id @default(cuid())
  bidId        String
  bid          Bid     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  rfqItemId    String
  rfqItem      RfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)
  unitPrice    Decimal @db.Decimal(14, 2)
  quantity     Float
  leadTimeDays Int     @default(7)
  notes        String?
}

model Order {
  id              String         @id @default(cuid())
  reference       String         @unique
  type            OrderType      @default(RFQ)
  rfqId           String?
  rfq             Rfq?           @relation(fields: [rfqId], references: [id])
  bidId           String?
  bid             Bid?           @relation(fields: [bidId], references: [id])
  buyerId         String
  buyer           User           @relation(fields: [buyerId], references: [id])
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  items           OrderItem[]
  subtotal        Decimal        @default(0) @db.Decimal(14, 2)
  vat             Decimal        @default(0) @db.Decimal(14, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(14, 2)
  total           Decimal        @db.Decimal(14, 2)
  currency        String         @default("SAR")
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus  @default(UNPAID)
  deliveryCity    String?
  deliveryAddress String?
  contactPhone    String?
  notes           String?
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([buyerId])
  @@index([companyId])
  @@index([type, status])
}

model OrderItem {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material?     @relation(fields: [materialId], references: [id])
  listingId  String?
  listing    PriceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name       String
  unit       String
  unitPrice  Decimal       @db.Decimal(14, 2)
  quantity   Float
  lineTotal  Decimal       @db.Decimal(14, 2)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String       @id @default(cuid())
  cartId    String
  cart      Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId String
  listing   PriceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Float
  createdAt DateTime     @default(now())

  @@unique([cartId, listingId])
}

model Feed {
  id            String    @id @default(cuid())
  name          String    @unique
  url           String
  format        String    @default("json")
  companyId     String?
  city          String?
  autoPublish   Boolean   @default(false)
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  lastStatus    String?
  lastItemCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

enum PaymentProvider {
  MOYASAR
  MANUAL
}

enum PaymentRecordStatus {
  INITIATED
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider     @default(MOYASAR)
  providerPaymentId String?             @unique
  amount            Decimal             @db.Decimal(14, 2)
  currency          String              @default("SAR")
  status            PaymentRecordStatus @default(INITIATED)
  raw               Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum ImportKind {
  SUPPLIER_PRICE_LIST
  BUYER_QUOTATION
  WEB_PAGE
  TEXT
}

enum ImportStatus {
  PROCESSING
  REVIEW
  PUBLISHED
  FAILED
  REJECTED
}

enum ImportRowStatus {
  SUGGESTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum OutreachChannel {
  EMAIL
  WHATSAPP
  LINK
}

model PriceImport {
  id             String           @id @default(cuid())
  kind           ImportKind
  status         ImportStatus     @default(PROCESSING)
  sourceName     String
  supplierName   String?
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id])
  uploadedById   String
  uploadedBy     User             @relation(fields: [uploadedById], references: [id])
  fileName       String?
  mimeType       String?
  city           String?
  quotationDate  DateTime?
  aiUsed         Boolean          @default(false)
  model          String?
  extractedCount Int              @default(0)
  publishedCount Int              @default(0)
  error          String?
  rawText        String?
  feedId         String?
  rows           PriceImportRow[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([uploadedById])
  @@index([status, kind])
}

model PriceImportRow {
  id             String          @id @default(cuid())
  importId       String
  import         PriceImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  rawName        String
  rawUnit        String?
  rawPrice       String?
  rawCity        String?
  brand          String?
  notes          String?
  price          Decimal?        @db.Decimal(14, 2)
  unit           String
  city           String?
  materialId     String?
  material       Material?       @relation(fields: [materialId], references: [id])
  confidence     Float           @default(0)
  alternatives   Json?
  status         ImportRowStatus @default(SUGGESTED)
  createMaterial Boolean         @default(false)
  position       Int             @default(0)

  @@index([importId])
}

model PriceUpdateRequest {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenHash   String          @unique
  channel     OutreachChannel @default(LINK)
  createdById String?
  sentAt      DateTime        @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  updatedRows Int             @default(0)

  @@index([companyId])
}
