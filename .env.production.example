# ===== copy to .env on the server and fill in =====
DOMAIN=mysupplier.sa
PUBLIC_BASE_URL=https://mysupplier.sa
WEB_BASE_URL=https://mysupplier.sa
CORS_ORIGINS=https://mysupplier.sa

# database (docker-compose.prod.yml builds DATABASE_URL from these)
POSTGRES_DB=mysupplier
POSTGRES_USER=mysupplier
POSTGRES_PASSWORD=CHANGE-ME-long-random

# security — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-64-hex-chars
ADMIN_EMAIL=admin@mysupplier.sa
ADMIN_PASSWORD=CHANGE-ME-strong-password
SEED_DEMO_DATA=0
OTP_REQUIRED=1
OTP_DEBUG_RETURN_CODE=0
WEB_CONCURRENCY=2

# payments — Moyasar (mada, cards, Apple Pay, STC Pay)
PAYMENT_PROVIDER=moyasar
MOYASAR_SECRET_KEY=sk_live_xxx
MOYASAR_PUBLISHABLE_KEY=pk_live_xxx
MOYASAR_WEBHOOK_SECRET=CHANGE-ME
PLATFORM_FEE_PCT=2.5
PLATFORM_VAT_NUMBER=3xxxxxxxxxxxxxx3
PLATFORM_BANK_INSTRUCTIONS=Bank: … — IBAN: SA… — Beneficiary: …

# OTP / notifications
SMS_PROVIDER=unifonic
UNIFONIC_APP_SID=xxx
UNIFONIC_SENDER_ID=MySupplier
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@mysupplier.sa
SMTP_PASSWORD=xxx
SMTP_FROM=no-reply@mysupplier.sa
WHATSAPP_PROVIDER=console
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=
