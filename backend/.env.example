# Database — SQLite by default (backend/data/mysupplier.db). For production use Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mysupplier
DATABASE_URL=

# Long random string. Auto-generated into backend/data/jwt.secret when empty.
JWT_SECRET=

# First admin account (created on first start)
ADMIN_EMAIL=admin@mysupplier.sa
ADMIN_PASSWORD=Admin@2026

# 1 = create demo suppliers/prices on first start, 0 = catalog + admin only
SEED_DEMO_DATA=1

# Comma separated allowed web origins, * for all
CORS_ORIGINS=*
VAT_RATE=0.15
