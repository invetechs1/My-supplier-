# Database — SQLite by default (backend/data/mysupplier.db). For production use Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mysupplier
DATABASE_URL=

# Long random string. Auto-generated into backend/data/jwt.secret when empty.
JWT_SECRET=

# First admin account (created on first start)
ADMIN_EMAIL=admin@mysupplier.sa
ADMIN_PASSWORD=Admin@2026

# 1 = create demo suppliers/prices on first start, 0 = catalog + admin only
SEED_DEMO_DATA=1

# Comma separated allowed web origins, * for all
CORS_ORIGINS=*
VAT_RATE=0.15

# ---- Payments (see docs/INTEGRATIONS.md) ----
PAYMENT_PROVIDER=mock            # mock | moyasar
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
PLATFORM_FEE_PCT=2.5
PLATFORM_VAT_NUMBER=300000000000003
PLATFORM_BANK_INSTRUCTIONS=Bank: Al Rajhi Bank — IBAN: SA00 0000 0000 0000 0000 0000 — Beneficiary: My Supplier Co.
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:8000

# ---- OTP ----
OTP_REQUIRED=0                   # 1 = phone/email verification mandatory at registration
OTP_DEBUG_RETURN_CODE=auto       # auto: return the code in the API response only while the provider is "console"

# ---- Notification channels ----
EMAIL_PROVIDER=console           # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mysupplier.sa
SMS_PROVIDER=console             # console | unifonic | twilio
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=MySupplier
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_PROVIDER=console        # console | twilio | meta
TWILIO_WHATSAPP_FROM=
META_WA_PHONE_ID=
META_WA_TOKEN=
PUSH_PROVIDER=expo               # expo | console
EXPO_ACCESS_TOKEN=

# ---- Jobs / limits / migrations ----
JOBS_ENABLED=1
FEED_FETCH_INTERVAL_HOURS=24
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_OTP_PER_MINUTE=6
AUTO_CREATE_TABLES=1             # 0 in production; run: alembic upgrade head
