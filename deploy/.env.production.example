# Copy to deploy/.env and fill in. Never commit the real file.
DOMAIN=mysupplier.sa
API_DOMAIN=api.mysupplier.sa

POSTGRES_USER=mysupplier
POSTGRES_PASSWORD=CHANGE-ME-long-random-password
POSTGRES_DB=mysupplier

# openssl rand -hex 48
JWT_SECRET=CHANGE-ME-at-least-32-random-characters
JWT_EXPIRES_IN=7d
APP_SCHEME=mysupplier

# Transactional email (any SMTP provider: SES, SendGrid, Mailgun, Zoho, Microsoft 365)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MySupplier <no-reply@mysupplier.sa>"

# Moyasar payments (Mada / Visa / Mastercard / Apple Pay). Leave empty until the account is approved.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# Legal entity printed on invoices (ZATCA QR) and bank-transfer instructions
PLATFORM_LEGAL_NAME="MySupplier Trading Co."
PLATFORM_VAT_NUMBER=300000000000003
PLATFORM_ADDRESS="Riyadh, Kingdom of Saudi Arabia"
VAT_RATE=0.15
BANK_NAME="Al Rajhi Bank"
BANK_IBAN="SA00 0000 0000 0000 0000 0000"
BANK_BENEFICIARY="MySupplier Trading Co."

# AI price collection (Claude) – console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OUTREACH_AUTO=true
OUTREACH_STALE_DAYS=14
