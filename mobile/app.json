{
  "expo": {
    "name": "مورّدي — Build for Less",
    "slug": "mysupplier",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mysupplier",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0F3D24",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.mysupplier.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "sa.mysupplier.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D24"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBase": "https://api.mysupplier.sa",
      "eas": {
        "projectId": ""
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#175934"
        }
      ]
    ],
    "description": "Build for Less — building material prices from every supplier, RFQs and bidding.",
    "icon": "./assets/icon.png"
  }
}